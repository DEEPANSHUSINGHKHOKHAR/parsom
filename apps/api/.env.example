NODE_ENV=production
PORT=5000

FRONTEND_URL=https://parsomattire.studio
ADMIN_FRONTEND_URL=https://admin.parsomattire.studio
CORS_ORIGINS=https://parsomattire.studio,https://admin.parsomattire.studio
APP_URL=https://api.parsomattire.studio
TRUST_PROXY_HOPS=1

DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=parsom_brand
DB_SSL_CA=
DB_SSL_REJECT_UNAUTHORIZED=true

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

LOG_LEVEL=info
REQUEST_BODY_LIMIT=1mb
URLENCODED_BODY_LIMIT=1mb
REDIS_URL=
RATE_LIMITER_PREFIX=parsom

GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_ORDERS_RANGE=Orders!A:Z
GOOGLE_SHEETS_NOTIFY_RANGE=NotifyRequests!A:Z
GOOGLE_OAUTH_CLIENT_ID=

RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace-with-your-razorpay-key-secret

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=parsom
